cat > 
.gitignore << 'EOF'
# Dependencies
node_modules/
client/node_modules/
server/node_modules/
vendor/
.venv/

# Folders and files generated by build tools
dist/
client/dist/
server/dist/
build/
sandbox/
*.o

# Editors and IDE
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# Secrets 
.env
*.key
*.pem

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

EOF
